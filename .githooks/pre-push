#!/bin/sh
# Escanea secretos antes de cada push (punto 2).
# Activar una vez con:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks no está instalado. Instálalo: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi
gitleaks git . --redact --exit-code 1 || {
  echo "gitleaks encontró posibles secretos. Push cancelado." >&2
  exit 1
}
