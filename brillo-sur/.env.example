# Copia este archivo a .env.local y llena los valores. NUNCA subas .env.local a Git.
# En Vercel: Project Settings → Environment Variables (mismos nombres).

# --- Públicas (llegan al navegador; no son secretas) ---
# URL del proyecto Supabase: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). Segura solo con RLS activo en todas las tablas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile → Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Número de WhatsApp del negocio con código de país, solo dígitos (ej. 51900000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL pública del sitio, con https (ej. https://brillosur.pe)
NEXT_PUBLIC_SITE_URL=

# --- Secretas (solo servidor; JAMÁS con prefijo NEXT_PUBLIC_) ---
# Supabase service_role: salta RLS. Solo se usa en código de servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile → Secret Key
TURNSTILE_SECRET_KEY=
# Clave para cifrar el teléfono del cliente (pgcrypto). Genera una con: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=
